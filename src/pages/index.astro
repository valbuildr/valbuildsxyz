---
import MainLayout from "../layouts/MainLayout.astro";
import { ClipboardPen, ArrowUpRight } from "@lucide/astro";
import {
  Discord,
  Youtube,
  Bluesky,
  Mastodon,
  Github,
  Tiktok,
  Instagram,
} from "simple-icons-astro";
---

<head>
  <meta property="og:title" content="valbuilds.xyz" />
  <meta
    property="og:description"
    content="Hey, I'm Valentine. An asexual transfem lesbian that makes nerdy stuff online."
  />
  <meta property="og:image" content="https://valbuilds.xyz/pfp.png" />
</head>

<MainLayout>
  <img
    class="aspect-square rounded-lg h-32 mx-auto mb-1"
    src="/pfp.png"
    alt="A feminine character sticking their tounge out."
  />

  <h1 class="text-3xl font-semibold text-center mb-1">
    Hey, I'm Valentine. <a
      href="https://en.pronouns.page/@valbuilded"
      target="_blank"
      class="text-xl font-light hover:underline">(she/they)</a
    >
  </h1>
  <h2 class="text-2xl font-medium text-center mb-4">
    An asexual transfem lesbian that makes nerdy stuff online.
  </h2>

  <!-- Survey container -->
  <!-- <div class="border p-4 max-w-lg mx-auto mb-4 space-y-1">
    <p
      class="bg-royal-purple-800 text-white dark:bg-royal-purple-200 dark:text-black uppercase tracking-wide p-1 px-3 rounded-full font-bold w-fit text-sm"
    >
      <ClipboardPen class="inline-block mr-1" size={24} /> Survey
    </p>
    <h3 class="font-medium text-2xl">
