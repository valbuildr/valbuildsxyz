    >
      <Tiktok class="inline-block mr-1" size={16} /> TikTok
    </a>
    <!-- instagram -->
    <a
      href="https://instagram.com/valbuilded"
      target="_blank"
      class="bg-black dark:bg-white dark:text-black px-2 p-1 font-medium text-sm uppercase tracking-wide text-white cursor-pointer"
    >
      <Instagram class="inline-block mr-1" size={16} /> Instagram
    </a>
