      >Fill it out on Google Forms <ArrowUpRight
        class="inline-block ml-1"
        size={16}
      /></a
    >
  </div> -->

  <div class="flex flex-wrap gap-2 mx-auto w-fit items-center justify-center">
    <a
      href="https://discord.gg/UKVMvUG2h9"
      target="_blank"
      class="bg-[#5865F2] px-2 p-1 font-medium text-sm uppercase tracking-wide text-white cursor-pointer"
    >
      <Discord class="inline-block mr-1" size={16} /> Discord
    </a>
    <a
      href="https://www.youtube.com/@valbuildr"
      target="_blank"
      class="bg-[#FF0000] px-2 p-1 font-medium text-sm uppercase tracking-wide text-white cursor-pointer"
    >
      <Youtube class="inline-block mr-1" size={16} /> YouTube
    </a>
    <!-- bluesky -->
    <a
      href="https://bsky.app/valbuilds.xyz"
      target="_blank"
      class="bg-[#0285FF] px-2 p-1 font-medium text-sm uppercase tracking-wide text-white cursor-pointer"
    >
      <Bluesky class="inline-block mr-1" size={16} /> Bluesky
    </a>
    <!-- mastodon -->
    <a
      href="https://wetdry.world/@valbuildr"
      target="_blank"
      class="bg-[#6364FF] px-2 p-1 font-medium text-sm uppercase tracking-wide text-white cursor-pointer"
    >
      <Mastodon class="inline-block mr-1" size={16} /> Mastodon
    </a>
    <!-- github -->
    <a
      href="https://github.com/valbuildr"
      target="_blank"
      class="bg-black dark:bg-white dark:text-black px-2 p-1 font-medium text-sm uppercase tracking-wide text-white cursor-pointer"
    >
